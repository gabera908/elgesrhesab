# ===== Infrastructure =====
POSTGRES_USER=bridge_accounting
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=accounting
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ===== Application =====
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_64_CHAR_SECRET_KEY_FOR_PRODUCTION_USE
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ===== Backend URL (internal) =====
BACKEND_INTERNAL_URL=http://backend:8010

# ===== Security =====
# CORS origins separated by comma - use actual domain in production
ALLOWED_ORIGINS=https://accounting.bridge-media.org
# Rate limiting
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=120
# 2FA
TWOFA_ISSUER=الجسر المصري للإعلام والتنمية
# Backup encryption passphrase
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_BACKUP_PASSPHRASE_STRONG
# Cookie Secure flag: leave unset for auto (Secure only on HTTPS).
# Set to false when serving over plain HTTP inside a LAN (otherwise browsers
# drop the HttpOnly auth cookies and the login loop returns 401 forever).
# COOKIE_SECURE=false

# ===== Company defaults =====
COMPANY_NAME=الجسر المصري للإعلام والتنمية
COMPANY_CURRENCY=EGP
COMPANY_FISCAL_YEAR_START_MONTH=1

# ===== Network =====
# اسم المضيف للوصول من الشبكة المحلية
HOST_DOMAIN=accounting.bridge-media.org